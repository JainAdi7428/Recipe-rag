# Every setting the project reads, with placeholders only.
#
# Copy this file to `.env` for local use. `.env` is gitignored; THIS file is
# committed, so it must never contain a real value.
#
# On Streamlit Cloud, `.env` is not used: paste the same names into the app's
# Secrets panel instead (TOML: NAME = "value"). Streamlit exposes them as
# environment variables, which is where the code reads them.

# ---------------------------------------------------------------------------
# LLM judge -- optional. Without it, borderline questions fall back to the
# rule-based gate and everything else still works.
# ---------------------------------------------------------------------------

# An api.openai.com key (starts "sk-"), OR an Azure OpenAI key.
OPENAI_API_KEY=replace-me

# Azure only. All three must come from the SAME Azure resource as the key above.
# The endpoint is the base URL only, ending in ".openai.azure.com/".
# Delete these three lines when using an "sk-" key from api.openai.com.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ---------------------------------------------------------------------------
# Web fallback -- optional. Without it, requests the dataset cannot answer end
# in the apology instead of a web search. Free key at https://serper.dev
# ---------------------------------------------------------------------------

SERPER_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Deployment only -- NOT needed on a machine that has built the index.
# app.py only reads these when .artifacts/ is empty, i.e. in a fresh cloud
# container, where it downloads the index from Hugging Face.
# ---------------------------------------------------------------------------

# RECIPE_RAG_INDEX_REPO=<hf-username>/recipe-rag-index
# HF_TOKEN=hf_replace-me          # a READ token; needed because the dataset is private

# ---------------------------------------------------------------------------
# Rarely needed overrides -- these do NOT work from this file.
#
# recipe_rag/config.py reads them at import time, before this file is loaded,
# so they must be real environment variables (or Streamlit secrets, which are).
# In PowerShell, for the current session:
#     $env:RECIPE_RAG_ARTIFACTS = "D:\recipe-index"
# ---------------------------------------------------------------------------

#   RECIPE_RAG_ARTIFACTS   keep the index outside the project folder
#   RECIPE_RAG_ENV         read secrets from a file other than this project's .env
#   RECIPE_RAG_LLM_MODEL   model name for api.openai.com (default gpt-4o-mini);
#                          Azure uses AZURE_OPENAI_DEPLOYMENT instead
